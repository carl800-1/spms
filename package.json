{
  "name": "spms",
  "version": "3.0.5",
  "description": "备件仓库管理系统 v3.0.5（Electron 桌面版，本地 JSON 文件存储，数据库置于程序同目录；支持 PDA 浏览器扫码出入库，主进程内置局域网 HTTP 服务；已移除夹具管理模块，回归纯备件仓库系统）",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.spms.warehouse",
    "productName": "备件仓库管理系统",
    "electronDist": "node_modules/electron/dist",
    "files": [
      "main.js",
      "preload.js",
      "store.js",
      "mobile-server.js",
      "index.html",
      "desktop.html",
      "mobile.html",
      "manifest.json",
      "icons/**",
      "css/**",
      "js/**",
      "仓库管理流程图.svg"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "dir",
        "portable"
      ],
      "artifactName": "备件仓库管理系统_v3.0.5.${ext}"
    }
  },
  "devDependencies": {
    "app-builder-bin": "^4.2.0",
    "electron": "^31.0.0",
    "electron-builder": "^26.0.0"
  },
  "dependencies": {
    "pinyin-match": "^1.2.10"
  }
}
